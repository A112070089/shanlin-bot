:root{--main:#8BA8BA;--dark:#1c3647;--deep:#365c73;--panel:#e9f2f6;--background:#f5f8fa;--border:#cbdde6;--muted:#587080;--white:#fff;--red:#b23938}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--background);color:var(--dark);font-family:-apple-system,BlinkMacSystemFont,"Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;font-size:17px;line-height:1.65}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.5}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #4c768e;outline-offset:2px}a{color:inherit;text-decoration:none}
.demo-ribbon{background:#244658;color:#f4fbfd;display:flex;justify-content:center;flex-wrap:wrap;gap:10px;padding:7px 16px;font-size:13px}.demo-ribbon strong{background:#d6e7ee;color:#1c3647;padding:1px 10px;border-radius:30px}.site-header{background:var(--main);border-bottom:1px solid #7799ab}.header-inner{max-width:1240px;padding:16px 24px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:flex;align-items:center;gap:12px;font-size:24px;font-weight:900}.brand small{display:block;font-size:10px;letter-spacing:.16em;font-weight:600}.brand-mark{font-size:27px;display:grid;place-items:center;color:#fff;background:#365c73;border-radius:10px;width:48px;height:48px}.head-actions,.admin-top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.plain-button,.outline-button,.primary-button,.upload-button{display:inline-flex;justify-content:center;align-items:center;padding:12px 18px;border-radius:10px;font-weight:700;min-height:48px;border:1px solid transparent;transition:background .15s,color .15s;white-space:normal;text-align:center}.plain-button{background:transparent;color:var(--dark)}.plain-button:hover{background:#e2edf3}.outline-button{color:var(--dark);background:#fff;border-color:#92b0c0}.outline-button:hover{background:#edf5f8}.primary-button,.upload-button{background:#365c73;color:#fff;border-color:#365c73}.primary-button:hover,.upload-button:hover{background:#29495e;color:#fff}.page-shell{max-width:1240px;margin:0 auto;padding:42px 24px 70px;min-height:70vh}.eyebrow{font-size:13px;letter-spacing:.16em;font-weight:900;color:#496d82}.chooser{padding:40px 0}.chooser h1,.hero h1{font-size:clamp(32px,4.5vw,57px);line-height:1.2;margin:14px 0 20px}.lead{font-size:21px;color:var(--muted);max-width:820px}.clinic-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:40px 0}.clinic-choice{text-align:left;border:1px solid var(--border);box-shadow:0 8px 30px rgba(35,64,82,.045);background:#fff;border-radius:20px;min-height:250px;padding:28px;display:flex;flex-direction:column;align-items:flex-start;gap:6px;color:var(--dark)}.clinic-choice:hover{border-color:#527992;background:#f1f7f9}.clinic-choice strong{font-size:30px}.clinic-choice em{margin-top:auto;font-size:16px;color:#285a76;font-style:normal;font-weight:800}.clinic-icon{font-size:28px;background:#eaf3f7;border-radius:100px;padding:0 12px;color:#315a70}.small-note{font-size:14px;color:#617889;line-height:1.75}.hero{display:flex;align-items:center;justify-content:space-between;gap:30px;background:linear-gradient(125deg,#e5eef3,#f7fbfd);border:1px solid var(--border);border-radius:22px;padding:36px;margin-bottom:24px}.hero h1{margin:14px 0}.hero p{margin:0;color:#4d6779}.hero-logo{width:112px;height:112px;flex:none;border-radius:20px;display:grid;place-items:center;background:var(--main);font-size:60px;color:#fff}.split-sections{display:grid;grid-template-columns:1fr 1fr;gap:20px}.panel{background:#fff;border:1px solid var(--border);border-radius:20px;padding:26px;margin-bottom:20px;box-shadow:0 3px 15px rgba(35,64,82,.035)}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:24px}.panel h2{font-size:25px;line-height:1.45;margin:0}.panel-head p{color:var(--muted);font-size:15px;margin:4px 0 0}.chip{background:#e7f1f5;color:#365c73;border:1px solid #c9dce6;border-radius:30px;padding:5px 11px;font-size:13px;font-weight:800;white-space:nowrap}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.info-grid>div{min-width:0;padding:16px;background:#f2f8fa;border-radius:12px}.info-grid small,.metric-row small{display:block;color:#5d7483;font-size:14px}.info-grid strong{font-size:17px;overflow-wrap:anywhere;white-space:pre-line}.demo-form label,.settings-form label,.login-shell label{display:block;font-weight:750;color:#344e60}.demo-form label:not(:last-child),.settings-form label{margin-bottom:15px}input:not([type='checkbox']):not([type='file']),select,textarea{display:block;width:100%;padding:11px 13px;border:1px solid #afc7d3;border-radius:9px;background:#fff;color:var(--dark);margin-top:6px;font-size:17px;min-height:49px}textarea{resize:vertical}.two-inputs{display:grid;grid-template-columns:1fr 1fr;gap:15px}.checkbox-stack{display:grid;gap:8px;margin:15px 0}.checkbox-stack label{display:flex;align-items:center;gap:9px;background:#f2f7fa;border-radius:8px;padding:8px 12px;font-size:15px}.checkbox-stack input{width:20px;height:20px;accent-color:#315a70}.catalog-public{margin-top:10px}.catalog-category{padding:18px 0;border-top:1px solid var(--border)}.catalog-category h3{margin:0 0 14px;font-size:22px}.catalog-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.catalog-card{border:1px solid #c7dbe6;border-radius:13px;padding:16px;overflow-wrap:anywhere}.catalog-card strong{font-size:18px}.catalog-card p{font-size:14px;color:var(--muted);line-height:1.65}.catalog-card .price{display:block;font-size:20px;font-weight:900;color:#284e66;margin-top:12px}.empty-state{background:#f3f8fa;border:1px dashed #bed3de;padding:30px;border-radius:13px;color:#536d7e}.admin-top{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:25px}.admin-top h1{font-size:36px;margin:4px 0}.admin-top p{color:var(--muted);margin:0}.metric-row{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:22px}.metric-row>div{border:1px solid var(--border);border-radius:13px;background:#fff;padding:17px 22px}.metric-row strong{font-size:32px;display:block}.form-footer{display:flex;align-items:center;flex-wrap:wrap;gap:18px}.import-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.upload-button{position:relative;overflow:hidden;cursor:pointer}.upload-button input{position:absolute;opacity:0;inset:0;width:100%;cursor:pointer}.summary-line{background:#eaf3f7;padding:12px 16px;border-radius:10px;font-weight:800;margin:16px 0}.list-tools{display:flex;gap:12px;margin:18px 0}.list-tools>*{margin:0!important}.list-tools input{flex:2}.list-tools select{flex:1}.edit-catalog{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.entry{border:1px solid var(--border);background:#fff;border-radius:12px;padding:17px;min-width:0}.entry-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.entry-top strong{font-size:18px;line-height:1.4;overflow-wrap:anywhere}.entry-kind{background:#eff5f8;border:1px solid #c7dce6;padding:2px 10px;border-radius:30px;font-size:12px;white-space:nowrap}.entry-source{font-size:12px;color:#718594;margin:6px 0 13px;overflow-wrap:anywhere}.entry-grid{display:grid;grid-template-columns:1fr 130px;gap:12px}.entry label{font-size:14px;font-weight:700}.entry input,.entry select,.entry textarea{font-size:15px;margin-top:4px}.checks{display:flex;gap:18px;margin:14px 0 0;flex-wrap:wrap}.checks label{display:flex;align-items:center;gap:7px;font-size:15px}.checks input{width:18px;height:18px;accent-color:#365c73}.issue{color:#9b3d2f;background:#fff1ed;padding:7px 9px;font-size:13px;border-radius:8px;margin-top:10px}.entry details{margin-top:12px;font-size:14px}.entry details summary{font-weight:750;cursor:pointer}.entry details ul{padding-left:20px}.entry textarea{width:100%;margin-top:7px}.admin-login{display:flex;justify-content:center;margin-top:55px}.login-shell{max-width:510px;width:100%;background:#fff;border:1px solid var(--border);border-radius:18px;padding:38px}.login-shell h1{font-size:30px;margin:12px 0}.login-shell p{color:var(--muted)}.login-shell form{margin:24px 0}.login-shell form button{margin-top:18px;width:100%}.booking-records{display:grid;gap:9px}.booking-row{display:flex;justify-content:space-between;gap:12px;align-items:center;background:#f2f8fa;padding:15px;border-radius:10px}.booking-row small{display:block;color:#617889}.notification{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#213d4e;color:#fff;border-radius:12px;padding:14px 20px;box-shadow:0 14px 50px rgba(0,0,0,.18);max-width:min(90vw,700px);z-index:50;font-size:16px}.notification.error{background:#8f3333}.foot{padding:25px;text-align:center;color:#5d7586;border-top:1px solid var(--border);font-size:13px}
[hidden]{display:none!important}
@media(max-width:900px){.split-sections,.catalog-cards,.clinic-grid{grid-template-columns:1fr}.catalog-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-logo{width:76px;height:76px;font-size:42px}.edit-catalog{grid-template-columns:1fr}}
@media(max-width:620px){body{font-size:16px}.page-shell{padding:20px 14px 45px}.header-inner{padding:10px 13px;align-items:flex-start;flex-wrap:wrap}.head-actions{width:100%;justify-content:space-between}.head-actions button{font-size:14px;padding:9px}.hero{padding:22px}.hero-logo{display:none}.two-inputs,.info-grid,.catalog-cards{grid-template-columns:1fr}.panel{padding:17px}.panel h2{font-size:22px}.panel-head{align-items:flex-start;flex-direction:column}.admin-top{flex-direction:column}.metric-row{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.metric-row>div{padding:9px}.metric-row strong{font-size:24px}.list-tools{flex-direction:column}.entry-grid{grid-template-columns:1fr}.chooser{padding:20px 0}.clinic-choice{min-height:205px}.login-shell{padding:25px}.import-bar>*{flex:1 1 auto}.booking-row{align-items:flex-start;flex-direction:column}}

/* v2 platform management keeps the existing #8BA8BA design system. */
.setup-callout{background:#e7f0f4;border:1px solid #bfd3df;border-radius:18px;padding:22px;max-width:820px;margin:15px 0 24px}
.setup-callout strong{font-size:23px}.setup-callout p{color:#49687a;margin:7px 0 14px}
.platform-clinics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.platform-clinic-card{border:1px solid var(--border);background:#f7fafc;padding:20px;border-radius:14px;min-width:0}
.platform-clinic-card strong{display:block;font-size:23px;margin-bottom:8px}
.platform-clinic-card p{margin:7px 0 14px;color:#567187;overflow-wrap:anywhere}
.platform-clinic-card .chip{display:inline-block}
#platformView .settings-form{max-width:880px}
#adminLogin input[readonly]{background:#eef4f6;color:#617788}
@media(max-width:700px){.platform-clinics{grid-template-columns:1fr}}
/* v3 clinic self-service, consistently using the #8BA8BA design system. */
.admin-subnav{display:flex;gap:9px;flex-wrap:wrap;margin:0 0 22px;padding:12px;background:#eaf2f6;border:1px solid var(--border);border-radius:15px}
.admin-subnav button{padding:10px 16px;background:#fff;border:1px solid #adc7d5;border-radius:9px;color:#26495e;font-weight:800;min-height:45px}
.admin-subnav button:hover{background:#d8e8f0}
.admin-subnav button.active{background:#365c73;color:#fff;border-color:#365c73}
.admin-pane{animation:appear .15s ease-out}@keyframes appear{from{opacity:.7}to{opacity:1}}
.staff-public{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
.staff-public-card{padding:16px;border:1px solid var(--border);border-radius:14px;background:#f5f9fb}
.staff-public-card strong{font-size:19px}.staff-public-card p{margin:8px 0 0;color:#48677c;font-size:15px}
.editor-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:22px}
.soft-panel{padding:20px;background:#f1f7f9;border:1px solid var(--border);border-radius:13px}
.soft-panel h3{margin:0 0 14px;font-size:21px}.soft-panel label{display:block;margin-bottom:12px;font-weight:750}
.inline-fields{display:flex;gap:10px;align-items:flex-end;margin-bottom:14px}.inline-fields input{flex:1;min-width:0;margin-top:0!important}
.managed-list{display:grid;gap:8px;margin-top:18px}.managed-row{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid var(--border);padding:9px 13px;border-radius:9px;gap:12px;min-width:0}
.managed-row strong{font-size:17px;overflow-wrap:anywhere}.managed-row small{display:block;color:#627889;font-size:13px}.compact-button{min-height:37px;padding:6px 13px;font-size:14px;flex:none}
.checklist-row{padding:9px 4px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #e0ebf1}
.check-done,.check-todo{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;font-weight:900;flex:none}
.check-done{background:#dcefe6;color:#1e7659}.check-todo{background:#fff1db;color:#885719}
#integrationSummary,#appointmentIntegration{padding:17px;border:1px solid var(--border);border-radius:13px;background:#f1f7f9;overflow-wrap:anywhere}
#integrationSummary p{margin:7px 0 0;color:#536b7c}.status-note{margin-top:12px;color:#75613e;font-size:14px}
.status-panel{margin-bottom:17px}.status-panel .status-chip{display:inline-block;padding:4px 12px;border-radius:25px;margin:0 0 11px;font-weight:800}.status-wait{background:#fff0db;color:#81551c}
.service-entry{display:flex;flex-direction:column;align-items:flex-start;gap:10px}.service-entry p{margin:0 0 8px;color:var(--muted)}
@media(max-width:900px){.editor-layout{grid-template-columns:1fr}.staff-public{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.admin-subnav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;padding:9px}.admin-subnav button{padding:7px;font-size:14px}.staff-public{grid-template-columns:1fr}.inline-fields{flex-direction:column;align-items:stretch}.inline-fields>*{width:100%}.soft-panel{padding:15px}}
