@router.get('/api/pilot/clinics/{clinic}/public')
def public_clinic(clinic:ClinicId):
    data=store().read(clinic,'config')
    published=store().read(clinic,'catalog_published')
    visible=[{k:v for k,v in e.items() if k in ('id','name','categoryId','type','description','components','price')}
             for e in published.get('items',[]) if e.get('enabled') and e.get('reviewed')]
    public={k:data.get(k,'') for k in ('name','phone','address','directions','hours','intro','elderlyDates','timeSlots')}
    return {'clinicId':clinic,'clinic':public,'categories':CATEGORIES,'items':visible,
            'catalogVersion':published.get('publishedVersion'), 'storage':STORAGE_MODE,
            'demoOnly':True}

@router.post('/api/pilot/clinics/{clinic}/demo-booking')
def demo_booking(clinic:ClinicId, payload:DemoBookingIn, request:Request):
    # No patient name, ID, phone, medical history or IP address is ever stored.
    if STORAGE_MODE!='local-demo' and os.getenv('PILOT_ALLOW_FIREBASE_DEMO_BOOKINGS','0')!='1':
        raise HTTPException(403,'Firebase 展示預約尚未啟用，請先設定明確的展示權限')
    config=store().read(clinic,'config')
    if payload.date not in config.get('elderlyDates',[]) or payload.time not in config.get('timeSlots',[]):
        raise HTTPException(422,'日期或時段不在本診所開放的示範時段內')
    catalog=store().read(clinic,'catalog_published')
    index={x['id']:x for x in catalog.get('items',[]) if x.get('enabled') and x.get('reviewed')}
    if len(payload.itemIds)!=len(set(payload.itemIds)):raise HTTPException(422,'自費檢查項目不可重複')
    if any(x not in index for x in payload.itemIds):raise HTTPException(422,'所選項目不存在於已發布目錄')
    snapshots=[{'id':x, 'name':index[x]['name'], 'price':index[x]['price']} for x in payload.itemIds]
    data={'id':'DEMO_'+secrets.token_hex(7),'clinicId':clinic,'alias':'展示訪客（虛構）',
          'plan':payload.plan,'date':payload.date,'time':payload.time,
          'selfPayItems':snapshots,'selfPayTotal':sum(x['price'] for x in snapshots),
          'source':'DEMO_ONLY','createdAt':now_iso()}
    store().append_demo_booking(clinic,data)
    return {'success':True,'bookingId':data['id'],'clinicId':clinic,'selfPayTotal':data['selfPayTotal'],
            'notice':'僅建立虛構展示預約，沒有預約真實健檢'}

@router.post('/api/pilot/admin/login')
def login(body:LoginIn, request:Request, response:Response):
    ip=request.client.host if request.client else 'unknown'
    with _lock:
        attempts=prune_failed(ip)
        if len(attempts)>=10:raise HTTPException(429,'嘗試次數過多，請稍後再試')
    if not account_ok(body.clinicId,body.username,body.password):
        with _lock:_failed[ip].append(time.monotonic())
        raise HTTPException(401,'帳號或密碼不正確')
    token=new_session(body.clinicId)
    sess=_sessions[sha256(token.encode()).hexdigest()]
    response.set_cookie(COOKIE,token,max_age=AUTH_TTL,httponly=True,samesite='strict',
                        secure=request.url.scheme=='https',path='/api/pilot')
    return {'success':True,'clinicId':body.clinicId,'csrf':sess['csrf'],'expiresIn':AUTH_TTL}

